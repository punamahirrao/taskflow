# Copy to .env.preprod. Start with ./run-data.ps1 -Data preprod.
# SQLite is the default: backend/db.preprod.sqlite3.
# Set this only when using a separate PostgreSQL database:
# PREPROD_DATABASE_URL=postgresql://taskflow:change-me@localhost:5432/taskflow_preprod
PREPROD_AI_ESTIMATOR_SERVICE_URL=http://127.0.0.1:8101
# PREPROD_SECRET_KEY=set-a-long-random-secret-unique-to-preprod
