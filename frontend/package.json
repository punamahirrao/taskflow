{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project storybook",
    "test:roadmap": "node --test scripts/roadmap.test.mjs",
    "test:roadmap:browser": "node scripts/roadmap.integration.mjs",
    "test:organizations:browser": "node scripts/organizations.integration.mjs",
    "test:navigation:browser": "node scripts/navigation.integration.mjs",
    "test:typography:browser": "node scripts/typography.integration.mjs",
    "test-storybook:watch": "vitest --project storybook",
    "chromatic": "chromatic --exit-once-uploaded",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test": "npm run test:unit && npm run test:roadmap",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev:preprod": "vite --mode preprod --host 127.0.0.1 --port 5175 --strictPort",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 5176 --strictPort",
    "test:preprod:browser": "node scripts/hardening.integration.mjs",
    "format": "prettier --write src .storybook *.ts scripts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "chromatic": "^18.14.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "msw": "^3.0.6",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.2"
    }
  }
}
